using Gtk 4.0;
using Adw 1;

template $KaghezMangaCard : Gtk.Box {
  orientation: vertical;
  spacing: 6;
  margin-start: 6;
  margin-end: 6;
  margin-top: 6;
  margin-bottom: 6;
  tooltip-text: bind template.model as <$KaghezManga> .title;
  Gtk.AspectFrame {
    ratio: 0.667;
    obey-child: false;

    child: Gtk.Picture poster {
      styles [
        "rounded"
      ]
      paintable: bind template.model as <$KaghezManga> .paintable;
      content-fit: cover;
    };
  }

  Gtk.Inscription title {
    styles [
      "heading"
    ]
    text: bind template.model as <$KaghezManga> .title;
    visible: bind template.show_title;
    xalign: 0.0;
    text-overflow: ellipsize_end;
  }
}