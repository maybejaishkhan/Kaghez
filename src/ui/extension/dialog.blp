using Gtk 4.0;
using Adw 1;

template $KaoriExtensionDialog : Adw.Dialog {
  title: bind template.model as <$KaoriManga> .name;
  can-close: true;
  content-width: 300;
  content-height: 300;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {

    }

    content: Gtk.Box {
      orientation: vertical;
      spacing: 12;

      Gtk.Image {
        paintable: bind template.model as <$KaoriExtension> .paintable;
        pixel-size: 150;
      }

      Gtk.Label {
        styles [
          "title-4"
        ]
        label: bind template.model as <$KaoriExtension> .name;
      }

      Gtk.Box {
        orientation: horizontal;
        spacing: 12;
        halign: center;

        Gtk.Label version {
          styles [
          "heading",
          "dimmed"
          ]
          label: bind template.model as <$KaoriExtension> .version_name;
        }

        Gtk.Label language {
          styles [
          "heading"
          ]
          label: bind template.model as <$KaoriExtension> .lang;
        }

        Gtk.Label age_rating {
          styles [
          "heading"
          ]
          label: bind $get_age_rating(template.model as <$KaoriExtension> .is_nsfw) as <string>;
        }
      }
    };
  };
}
